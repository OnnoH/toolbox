#!/bin/bash

FILES="a.txt b.txt c.txt"
for FILE in ${FILES}
do
  echo ${FILE}
done

for FILE in $(cat file-list)
do
  echo ${FILE}
done

# This file shows the ways to read values, the fragile ones included.
# shellcheck disable=SC2045
for FILE in $(ls -1 /var/log)
do
  echo ${FILE}
done

find . -iname "foo*" | while read FILE
do
  echo ${FILE}
done